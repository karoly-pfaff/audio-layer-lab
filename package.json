{
  "name": "audio-layer-lab",
  "private": true,
  "version": "1.0.1",
  "license": "ISC",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "audit:dependencies": "npm audit --audit-level=high",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}\"",
    "lint": "npm run lint:code && npm run lint:duplicates && npm run lint:dead-code",
    "lint:code": "eslint . --max-warnings 0 --cache --cache-strategy content",
    "lint:dead-code": "knip --no-progress --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "lint:duplicates": "jscpd --config .jscpd.json --no-colors --no-tips",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "test:a11y": "vitest run sources/accessibility.test.tsx sources/accessibilityTokens.test.ts sources/components/KeyboardHelp.test.tsx sources/components/StatusMessage.test.tsx sources/components/MixerControls.test.tsx sources/components/WaveformDisplay.test.tsx",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "validate": "npm run verify",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run audit:dependencies && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "music-metadata": "^11.12.3",
    "music-tempo": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jscpd": "^5.4.0",
    "jsdom": "^24.1.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
